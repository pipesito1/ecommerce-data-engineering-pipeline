FROM apache/spark:4.2.0

USER root

RUN mkdir -p /opt/spark/jars-extra

# ============================================================
# Hadoop AWS filesystem support
# ============================================================

ADD https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.5.0/hadoop-aws-3.5.0.jar \
    /opt/spark/jars-extra/hadoop-aws-3.5.0.jar

# AWS SDK bundle required by Hadoop 3.5.0
ADD https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/2.35.4/bundle-2.35.4.jar \
    /opt/spark/jars-extra/bundle-2.35.4.jar

# S3 Analytics Accelerator
ADD https://repo1.maven.org/maven2/software/amazon/s3/analyticsaccelerator/analyticsaccelerator-s3/1.3.1/analyticsaccelerator-s3-1.3.1.jar \
    /opt/spark/jars-extra/analyticsaccelerator-s3-1.3.1.jar

# ============================================================
# PostgreSQL JDBC driver
# ============================================================

ADD https://jdbc.postgresql.org/download/postgresql-42.7.7.jar \
    /opt/spark/jars-extra/postgresql-42.7.7.jar

# ============================================================
# Install dependencies into Spark's standard classpath
# ============================================================

RUN cp /opt/spark/jars-extra/*.jar /opt/spark/jars/ && \
    chown spark:spark \
        /opt/spark/jars/hadoop-aws-3.5.0.jar \
        /opt/spark/jars/bundle-2.35.4.jar \
        /opt/spark/jars/analyticsaccelerator-s3-1.3.1.jar \
        /opt/spark/jars/postgresql-42.7.7.jar && \
    chmod 644 \
        /opt/spark/jars/hadoop-aws-3.5.0.jar \
        /opt/spark/jars/bundle-2.35.4.jar \
        /opt/spark/jars/analyticsaccelerator-s3-1.3.1.jar \
        /opt/spark/jars/postgresql-42.7.7.jar

USER spark